# Public application origin, including protocol and port.
APP_ORIGIN=
# MySQL connection URL for the application database.
DATABASE_URL=
# disabled for local MySQL; verify with a CA certificate for a hosted database.
DATABASE_SSL_MODE=
# PEM contents of the provider CA certificate, supplied only at runtime.
DATABASE_SSL_CA=
# At least 32 random bytes. Set a separate value for each environment.
JWT_SECRET=
# Optional HTTP listen address and port.
HOST=
PORT=
# Credentials used only when seeding the demo account.
DEMO_USERNAME=
DEMO_PASSWORD=
# Throwaway MySQL database for integration tests. Never use production.
TEST_DATABASE_URL=
# MySQL container passwords. Use URL-safe values for MYSQL_PASSWORD.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Explicit opt-in for creating synthetic demonstration records.
ALLOW_DEMO_SEED=
