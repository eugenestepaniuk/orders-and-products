{
  "name": "orders-and-products",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node server.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "bootstrap": "5.3.8",
    "graphql": "17.0.2",
    "jose": "6.2.12",
    "leaflet": "1.9.4",
    "mysql2": "3.24.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
